# PostgreSQL initialization scripts are executed by Linux after Windows checkouts.
/infra/gitea/postgres/init/*.sh text eol=lf
# Sealed indexes hash original bytes; recognize retained CRLF as line endings.
/docs/reviews/2026-11-04-increment-5-full/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/reviews/2026-11-04-increment-5-replay-repair/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# A unified diff encodes an empty context line as one required space.
/docs/reviews/2026-11-04-increment-5-replay-repair/evidence/repair-normalized.patch whitespace=blank-at-eof,space-before-tab,cr-at-eol,-blank-at-eol
