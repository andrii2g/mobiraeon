# Copy to .env alongside compose.yaml in infra/gitea. Never commit .env.
# Required: run `openssl rand -hex 32` twice in WSL for two distinct passwords.
# Leave no spaces around '='. Hex avoids Compose interpolation characters.
# PostgreSQL administration only; never supplied to the Gitea container.
POSTGRES_ADMIN_PASSWORD=
# Gitea application role; owns only the gitea database, without superuser rights.
GITEA_DB_PASSWORD=

# Local-only WSL bootstrap. Keep the binding private during installation.
GITEA_BIND_ADDRESS=127.0.0.1
GITEA_DOMAIN=localhost
GITEA_HTTP_PORT=3000
GITEA_ROOT_URL=http://localhost:3000/
GITEA_SSH_PORT=2222

# If changing ports or the hostname, update ROOT_URL and DOMAIN together.
# See ../../docs/infrastructure.md before enabling network or Worker access.
